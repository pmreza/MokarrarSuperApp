# ==============================================================================
# MOKARRAR UNIFIED ENTERPRISE SUPER APP (.env)
# ==============================================================================

# General Environment
FASTAPI_ENV=development
ENVIRONMENT=local
PROJECT_NAME="Mokarrar Enterprise Super App"

# Unified JWT Security & Admin Credentials
SECRET_KEY=mokarrar_super_secret_jwt_key_2026_xyz_production_grade_random_seed
FIRST_SUPERUSER=admin@mokarrar.ir
FIRST_SUPERUSER_PASSWORD=Admin123456!
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# PostgreSQL Database (Internal Bridge: mokarrar-net)
POSTGRES_DB=mokarrar
POSTGRES_USER=postgres
POSTGRES_PASSWORD=mokarrar_secret_2026
POSTGRES_SERVER=mokarrar-db
POSTGRES_PORT=5432

# ==============================================================================
# EXTERNAL SERVICES ADAPTER INTEGRATION (PHASES 1, 2, 3)
# Set to 'true' to run Mokarrar standalone with realistic PostgreSQL mock state!
# ==============================================================================
MOCK_EXTERNAL_SERVICES=true

# Phase 1: Task Management Engine (Plane REST API)
PLANE_API_URL=http://plane-api:8000
PLANE_API_KEY=plane_api_key_placeholder
PLANE_WORKSPACE_SLUG=mokarrar-corp
PLANE_PROJECT_ID=project_uuid_placeholder

# Phase 2 & 3: Workflow Automation Engine (n8n Webhooks & HMAC)
N8N_WEBHOOK_URL=http://n8n:5678
N8N_WEBHOOK_SECRET=mokarrar_hmac_secret_2026
N8N_PR_PAID_WEBHOOK_PATH=/webhook/mokarrar-pr-paid
N8N_PLANE_TASK_DONE_PATH=/webhook/mokarrar-plane-task-done

# Phase 3: Inventory & Warehouse Engine (InvenTree REST API)
INVENTREE_API_URL=http://inventree-server:8000
INVENTREE_API_TOKEN=inv_token_placeholder_2026

# Frontend Configuration
VITE_API_URL=http://localhost:8000
